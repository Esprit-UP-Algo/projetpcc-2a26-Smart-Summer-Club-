                        <string notr="true">
QComboBox {
    background-color: rgba(22, 165, 179, 0.10);
    color: #2c3e50;
    border: 1.5px solid rgba(22, 165, 179, 0.65);
    padding: 8px 12px;
    border-radius: 6px;
