  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #4DB6C3;
    border-radius: 20px;
}

#mainFrame {
    background-color: white;
    border-radius: 20px;
    border: none;
}

#leftFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                               stop:0 #4DB6C3, stop:1 #2E9CAA);
    border-radius: 20px 0px 0px 20px;
}

#rightFrame {
    background-color: white;
    border-radius: 0px 20px 20px 0px;
    padding: 40px;
}

#beachLabel {
    background-color: transparent;
    border: none;
}

#logoCircle {
    background-color: transparent;
    border-radius: 30px;
    border: none;
}

#welcomeLabel {
    font-size: 28px;
    font-weight: bold;
    color: #2c3e50;
    background-color: transparent;
    border: none;
}

#emailLabel {
    font-size: 16px;
    color: #7f8c8d;
    background-color: transparent;
    border: none;
    margin-bottom: 20px;
}

#subtitleLabel {
    font-size: 14px;
    color: #4DB6C3;
    background-color: transparent;
    border: none;
    margin-bottom: 30px;
}

QLineEdit {
    padding: 15px;
    border: 2px solid #e0e4e7;
    border-radius: 8px;
    font-size: 14px;
    background-color: white;
    margin-bottom: 15px;
}

QLineEdit:focus {
    border-color: #4DB6C3;
    outline: none;
}

#loginButton, #nextButton {
    background-color: #4DB6C3;
    color: white;
    border: none;
    padding: 15px 30px;
    border-radius: 25px;
    font-size: 16px;
    font-weight: 600;
    margin-right: 10px;
}

#loginButton:hover, #nextButton:hover {
    background-color: #2E9CAA;
}

#loginButton:pressed, #nextButton:pressed {
    background-color: #1E7A85;
}

#backButton {
    background-color: transparent;
    color: #4DB6C3;
    border: 2px solid #4DB6C3;
    padding: 15px 30px;
    border-radius: 25px;
    font-size: 16px;
    font-weight: 600;
    margin-right: 10px;
}

#backButton:hover {
    background-color: #4DB6C3;
    color: white;
}

#backButton:pressed {
    background-color: #2E9CAA;
}

#errorLabel {
    color: #e74c3c;
    font-size: 13px;
    font-weight: normal;
    margin-top: 10px;
    background-color: transparent;
    border: none;
}</string>
