# Ignore sensitive files with API keys
passwords.txt

# Ignore environment files
.env
*.env
config.ini

# Ignore any credentials files
*credentials*
*secrets*
*token*

# Ignore build directories and compiled files
build/
**/build/
*.o
*.obj
*.exe
*.dll
*.lib
*.a
*.so
*.dylib

# Ignore Qt-specific files
*.pro.user
*.pro.user.*
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
Makefile*
.qmake.stash
